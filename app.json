{
  "expo": {
    "name": "Zactus-App",
    "slug": "zactus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_zactus.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo_zactus.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rodcampos.zactusapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_zactus.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.rodcampos.zactusapp"
    },
    "web": {
      "favicon": "./assets/logo_zactus.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2cb5c992-9def-4af9-bef9-b1a0dd7b877c"
      }
    },
    "owner": "rod-campos"
  }
}
